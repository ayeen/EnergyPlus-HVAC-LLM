  "common_errors_and_solutions": [
    {
      "error": "Zone Name for Master Thermostat Location must be entered when Master Thermostat Priority Control Type = MASTERTHERMOSTATPRIORITY",
      "cause": "Field 14 is MasterThermostatPriority but Field 13 is blank",
      "solution": "Either set Field 13 to a valid zone name, or change Field 14 to LoadPriority",
      "recommended_fix": "Change Field 14 to LoadPriority (works for most applications)"
    },
    {
      "error": "Resistive Defrost Heater Capacity = 0.0 for defrost strategy = RESISTIVE",
      "cause": "Resistive defrost selected but heater capacity is 0",
      "solution": "Set Field 27 to Autosize or positive value",
      "recommended_fix": "Change defrost strategy to ReverseCycle (more efficient)"
    },
    {
      "error": "VRF Heat Pump Min/Max Operating Temperature Limits exceeded",
      "cause": "Weather temperatures outside specified operating range",
      "solution": "Expand temperature limits in Fields 5-6 (cooling) or 10-11 (heating)",
      "recommended_fix": "Use wider ranges: cooling -10 to 48°C, heating -25 to 18°C"
    },
    {
      "error": "Zero cooling/heating capacity",
      "cause": "Missing thermostat object or incorrect thermostat reference",
      "solution": "Ensure HVACTemplate:Thermostat exists and Field 3 of Zone:VRF references it correctly",
      "critical": "Every zone needs a thermostat object"
    },
    {
      "error": "condenser_type - Failed to match against any enum values",
      "cause": "Invalid condenser type value",
      "solution": "Set condenser_type to valid enum: AirCooled, EvaporativelyCooled, or WaterCooled",
      "recommended_fix": "Use AirCooled (most common)"
    },
    {
      "error": "gross_rated_heating_cop - Value type string not permitted",
      "cause": "Non-numeric value in COP field",
      "solution": "Set COP to numeric value (typically 3.0-4.5)",
      "recommended_fix": "Use 3.5 for heating COP"
    }
  ],

  "best_practices": [
    {
      "practice": "Always create thermostats first",
      "reason": "Zone:VRF objects reference thermostats - they must exist",
      "implementation": "Generate HVACTemplate:Thermostat for each zone before Zone:VRF objects"
    },
    {
      "practice": "Use LoadPriority for control type",
      "reason": "Works for most applications without requiring master zone specification",
      "implementation": "Set Master_Thermostat_Priority_Control_Type to LoadPriority"
    },
    {
      "practice": "Use Autosize for capacities",
      "reason": "Ensures proper sizing based on calculated loads",
      "implementation": "Set capacity fields to 'Autosize' rather than specific values"
    },
    {
      "practice": "Use wide temperature operating ranges",
      "reason": "Prevents simulation failures in extreme weather",
      "implementation": "Cooling: -10 to 48°C, Heating: -25 to 18°C"
    },
    {
      "practice": "Enable heat recovery for mixed-use buildings",
      "reason": "Significant energy savings when zones have opposing loads",
      "implementation": "Set Heat_Pump_Waste_Heat_Recovery to Yes"
    },
    {
      "practice": "Use ReverseCycle defrost",
      "reason": "More efficient than resistive, no capacity specification needed",
      "implementation": "Set Defrost_Strategy to ReverseCycle"
    }
  ]
