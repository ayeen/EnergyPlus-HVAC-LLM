  "hvactemplate_thermostat": {
    "object_name": "HVACTemplate:Thermostat",
    "description": "Defines zone temperature setpoints for heating and cooling control.",
    "total_fields": 5,
    "required_fields": ["Name"],
    
    "detailed_fields": [
      {
        "field_number": 1,
        "field_name": "Name",
        "field_id": "A1",
        "type": "alpha",
        "required": true,
        "description": "Unique identifier. Referenced by HVACTemplate:Zone:VRF objects.",
        "example": "Thermostat_Zone1",
        "naming_convention": "Thermostat_<ZoneName>"
      },
      {
        "field_number": 2,
        "field_name": "Heating_Setpoint_Schedule_Name",
        "field_id": "A2",
        "type": "alpha",
        "required": false,
        "description": "Schedule for variable heating setpoints.",
        "default": "blank (uses constant setpoint)",
        "notes": "Use schedule for night setback or occupancy-based control"
      },
      {
        "field_number": 3,
        "field_name": "Constant_Heating_Setpoint",
        "field_id": "N1",
        "type": "real",
        "units": "C",
        "required": false,
        "description": "Fixed heating setpoint when no schedule specified.",
        "default": "blank",
        "typical_range": "18-22",
        "example": 21.0
      },
      {
        "field_number": 4,
        "field_name": "Cooling_Setpoint_Schedule_Name",
        "field_id": "A3",
        "type": "alpha",
        "required": false,
        "description": "Schedule for variable cooling setpoints.",
        "default": "blank (uses constant setpoint)"
      },
      {
        "field_number": 5,
        "field_name": "Constant_Cooling_Setpoint",
        "field_id": "N2",
        "type": "real",
        "units": "C",
        "required": false,
        "description": "Fixed cooling setpoint when no schedule specified.",
        "default": "blank",
        "typical_range": "23-26",
        "example": 24.0
      }
    ],

    "common_configurations": [
