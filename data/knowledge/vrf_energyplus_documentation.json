{
  "metadata": {
    "source": "EnergyPlus Input Output Reference Documentation",
    "version": "25.2.0",
    "last_updated": "2026-01-02",
    "objects_documented": [
      "HVACTemplate:System:VRF",
      "HVACTemplate:Zone:VRF",
      "HVACTemplate:Thermostat",
      "AirConditioner:VariableRefrigerantFlow",
      "ZoneHVAC:TerminalUnit:VariableRefrigerantFlow"
    ]
  },
  
  "vrf_system_overview": {
    "description": "Variable Refrigerant Flow (VRF) systems are sophisticated HVAC systems that modulate refrigerant flow to multiple indoor units based on individual zone demands. They offer high efficiency and precise temperature control.",
    "key_features": [
      "Single outdoor unit serves multiple indoor units",
      "Variable speed compressor for part-load efficiency",
      "Individual zone temperature control",
      "Heat recovery capability (simultaneous heating and cooling)",
      "Long refrigerant piping runs possible",
      "Quiet indoor operation"
    ],
    "applications": [
      "Commercial office buildings",
      "Hotels and hospitality",
      "Residential multi-family buildings",
      "Retail spaces",
      "Healthcare facilities",
      "Educational buildings"
    ],
    "energyplus_modeling_approach": "EnergyPlus models VRF systems using either HVACTemplate objects (simplified) or detailed objects (AirConditioner:VariableRefrigerantFlow). The HVACTemplate approach is recommended for most applications."
  },

  "hvactemplate_system_vrf": {
    "object_name": "HVACTemplate:System:VRF",
    "description": "Creates a complete VRF outdoor unit (heat pump) that serves multiple zone terminal units. This is the main system object that defines overall system characteristics.",
    "total_fields": 37,
    "required_fields": ["Name"],
    
    "field_groups": {
      "identification": {
        "fields": [1, 2],
        "description": "System naming and availability scheduling"
      },
      "cooling_performance": {
        "fields": [3, 4, 5, 6],
        "description": "Cooling capacity, COP, and operating temperature limits"
      },
      "heating_performance": {
        "fields": [7, 8, 9, 10, 11, 12],
        "description": "Heating capacity, COP, sizing ratio, and operating limits"
      },
      "control_strategy": {
        "fields": [13, 14, 15],
        "description": "Master thermostat control and scheduling"
      },
      "heat_recovery": {
        "fields": [16],
        "description": "Simultaneous heating/cooling capability"
      },
      "piping": {
        "fields": [17, 18, 19],
        "description": "Refrigerant piping characteristics and correction factors"
      },
      "compressor": {
        "fields": [20, 21, 22, 23],
        "description": "Crankcase heater and compressor configuration"
      },
      "defrost": {
        "fields": [24, 25, 26, 27, 28],
        "description": "Defrost strategy, control, and limitations"
      },
      "condenser": {
        "fields": [29, 30, 31, 32, 33, 34, 35, 36],
        "description": "Condenser type, water/evaporative cooling settings"
      },
      "fuel": {
        "fields": [37],
        "description": "Energy source for the system"
      }
    },

    "detailed_fields": [
      {
        "field_number": 1,
        "field_name": "Name",
        "field_id": "A1",
        "type": "alpha",
        "required": true,
        "description": "Unique identifier for the VRF system. Referenced by HVACTemplate:Zone:VRF objects.",
        "default": null,
        "example": "VRF_System_1"
      },
      {
        "field_number": 2,
        "field_name": "System_Availability_Schedule_Name",
        "field_id": "A2",
        "type": "alpha",
        "required": false,
        "description": "Schedule that defines when the system is available to operate. Blank means always available.",
        "default": "Always available",
        "example": "HVAC_Operation_Schedule"
      },
      {
        "field_number": 3,
        "field_name": "Gross_Rated_Total_Cooling_Capacity",
        "field_id": "N1",
        "type": "real",
        "units": "W",
        "required": false,
        "description": "Total cooling capacity at rated conditions. Use 'Autosize' for automatic sizing based on zone loads.",
        "default": "Autosize",
        "typical_range": "5000-500000 W",
        "example": "Autosize"
      },
      {
        "field_number": 4,
        "field_name": "Gross_Rated_Cooling_COP",
        "field_id": "N2",
        "type": "real",
        "units": "W/W",
        "required": false,
        "description": "Coefficient of Performance for cooling at rated conditions. Higher values indicate better efficiency.",
        "default": 3.3,
        "typical_range": "2.5-5.0",
        "minimum": 1.0,
        "example": 3.5,
        "notes": "Modern VRF systems typically achieve COP of 3.5-4.5"
      },
      {
        "field_number": 5,
        "field_name": "Minimum_Outdoor_Temperature_in_Cooling_Mode",
        "field_id": "N3",
        "type": "real",
        "units": "C",
        "required": false,
        "description": "Lowest outdoor temperature at which cooling operation is allowed.",
        "default": -6.0,
        "typical_range": "-15 to 5",
        "example": -10.0,
        "notes": "Set lower for cold climates to allow cooling during shoulder seasons"
      },
      {
        "field_number": 6,
        "field_name": "Maximum_Outdoor_Temperature_in_Cooling_Mode",
        "field_id": "N4",
        "type": "real",
        "units": "C",
        "required": false,
        "description": "Highest outdoor temperature at which cooling operation is allowed.",
        "default": 43.0,
        "typical_range": "40-52",
        "example": 48.0,
        "notes": "Set higher for hot climates"
      },
      {
        "field_number": 7,
        "field_name": "Gross_Rated_Heating_Capacity",
        "field_id": "N5",
        "type": "real",
        "units": "W",
        "required": false,
        "description": "Total heating capacity at rated conditions. Use 'Autosize' for automatic sizing.",
        "default": "Autosize",
        "example": "Autosize"
      },
      {
        "field_number": 8,
        "field_name": "Rated_Heating_Capacity_Sizing_Ratio",
        "field_id": "N6",
        "type": "real",
        "required": false,
        "description": "Ratio of heating capacity to cooling capacity for sizing. 1.0 means equal capacities.",
        "default": 1.0,
        "typical_range": "0.8-1.3",
        "example": 1.0,
        "notes": "Values >1.0 for heating-dominated climates"
      },
      {
        "field_number": 9,
        "field_name": "Gross_Rated_Heating_COP",
        "field_id": "N7",
        "type": "real",
        "units": "W/W",
        "required": false,
        "description": "Coefficient of Performance for heating at rated conditions.",
        "default": 3.4,
        "typical_range": "2.5-4.5",
        "minimum": 1.0,
        "example": 3.5
      },
      {
        "field_number": 10,
        "field_name": "Minimum_Outdoor_Temperature_in_Heating_Mode",
        "field_id": "N8",
        "type": "real",
        "units": "C",
        "required": false,
        "description": "Lowest outdoor temperature at which heating operation is allowed.",
        "default": -20.0,
        "typical_range": "-30 to -10",
        "example": -25.0,
        "notes": "Cold climate VRF systems can operate to -25°C or lower"
      },
      {
        "field_number": 11,
        "field_name": "Maximum_Outdoor_Temperature_in_Heating_Mode",
        "field_id": "N9",
        "type": "real",
        "units": "C",
        "required": false,
        "description": "Highest outdoor temperature at which heating operation is allowed.",
        "default": 16.0,
        "typical_range": "15-21",
        "example": 18.0
      },
      {
        "field_number": 12,
        "field_name": "Minimum_Heat_Pump_Part_Load_Ratio",
        "field_id": "N10",
        "type": "real",
        "required": false,
        "description": "Minimum part-load ratio before cycling occurs. Lower values allow better modulation.",
        "default": 0.15,
        "typical_range": "0.1-0.3",
        "example": 0.15
      },
      {
        "field_number": 13,
        "field_name": "Zone_Name_for_Master_Thermostat_Location",
        "field_id": "A3",
        "type": "alpha",
        "required": "conditional",
        "description": "Zone that controls the system when using MasterThermostatPriority control. REQUIRED if Field 14 is 'MasterThermostatPriority'.",
        "default": null,
        "example": "Zone1",
        "critical_dependency": "Must be set when Master_Thermostat_Priority_Control_Type = MasterThermostatPriority",
        "common_error": "Fatal error if MasterThermostatPriority selected but this field is blank"
      },
      {
        "field_number": 14,
        "field_name": "Master_Thermostat_Priority_Control_Type",
        "field_id": "A4",
        "type": "choice",
        "required": false,
        "description": "How the system prioritizes heating vs cooling when zones have conflicting demands.",
        "default": "LoadPriority",
        "choices": [
          {
            "value": "LoadPriority",
            "description": "System responds to total building load. Recommended for most applications.",
            "recommended": true
          },
          {
            "value": "MasterThermostatPriority",
            "description": "Single zone controls system mode. Requires Field 13 to be set.",
            "requires_field_13": true
          },
          {
            "value": "ThermostatOffsetPriority",
            "description": "Zone furthest from setpoint controls mode."
          },
          {
            "value": "Scheduled",
            "description": "Schedule determines heating/cooling mode."
          }
        ],
        "example": "LoadPriority"
      },
      {
        "field_number": 15,
        "field_name": "Thermostat_Priority_Schedule_Name",
        "field_id": "A5",
        "type": "alpha",
        "required": "conditional",
        "description": "Schedule for mode control when using Scheduled priority type.",
        "default": null,
        "notes": "Only used when Master_Thermostat_Priority_Control_Type = Scheduled"
      },
      {
        "field_number": 16,
        "field_name": "Heat_Pump_Waste_Heat_Recovery",
        "field_id": "A6",
        "type": "choice",
        "required": false,
        "description": "Enables simultaneous heating and cooling in different zones.",
        "default": "No",
        "choices": ["Yes", "No"],
        "example": "Yes",
        "notes": "Heat recovery significantly improves efficiency in buildings with simultaneous heating/cooling loads"
      },
      {
        "field_number": 17,
        "field_name": "Equivalent_Piping_Length_used_for_Piping_Correction_Factor_in_Cooling_Mode",
        "field_id": "N11",
        "type": "real",
        "units": "m",
        "required": false,
        "description": "Total equivalent length of refrigerant piping for cooling capacity correction.",
        "default": 30.0,
        "typical_range": "10-100",
        "example": 30.0
      },
      {
        "field_number": 18,
        "field_name": "Vertical_Height_used_for_Piping_Correction_Factor",
        "field_id": "N12",
        "type": "real",
        "units": "m",
        "required": false,
        "description": "Height difference between outdoor unit and furthest indoor unit.",
        "default": 10.0,
        "typical_range": "0-50",
        "example": 10.0
      },
      {
        "field_number": 19,
        "field_name": "Equivalent_Piping_Length_used_for_Piping_Correction_Factor_in_Heating_Mode",
        "field_id": "N13",
        "type": "real",
        "units": "m",
        "required": false,
        "description": "Total equivalent length of refrigerant piping for heating capacity correction.",
        "default": 30.0,
        "example": 30.0
      },
      {
        "field_number": 20,
        "field_name": "Crankcase_Heater_Power_per_Compressor",
        "field_id": "N14",
        "type": "real",
        "units": "W",
        "required": false,
        "description": "Electric power for crankcase heater to prevent refrigerant migration.",
        "default": 15.0,
        "typical_range": "0-50",
        "example": 15.0
      },
      {
        "field_number": 21,
        "field_name": "Number_of_Compressors",
        "field_id": "N15",
        "type": "integer",
        "required": false,
        "description": "Number of compressors in the outdoor unit.",
        "default": 2,
        "typical_range": "1-4",
        "example": 2
      },
      {
        "field_number": 22,
        "field_name": "Ratio_of_Compressor_Size_to_Total_Compressor_Capacity",
        "field_id": "N16",
        "type": "real",
        "required": false,
        "description": "Fraction of total capacity provided by each compressor.",
        "default": 0.5,
        "example": 0.5,
        "notes": "For 2 compressors, 0.5 means equal size"
      },
      {
        "field_number": 23,
        "field_name": "Maximum_Outdoor_Dry_Bulb_Temperature_for_Crankcase_Heater",
        "field_id": "N17",
        "type": "real",
        "units": "C",
        "required": false,
        "description": "Crankcase heater operates below this temperature.",
        "default": 5.0,
        "example": 5.0
      },
      {
        "field_number": 24,
        "field_name": "Defrost_Strategy",
        "field_id": "A7",
        "type": "choice",
        "required": false,
        "description": "Method used to defrost outdoor coil during heating operation.",
        "default": "ReverseCycle",
        "choices": [
          {
            "value": "ReverseCycle",
            "description": "Uses refrigerant cycle reversal. More efficient, recommended.",
            "recommended": true
          },
          {
            "value": "Resistive",
            "description": "Uses electric resistance heaters. Requires Field 28 to be set.",
            "requires_field_28": true
          }
        ],
        "example": "ReverseCycle"
      },
      {
        "field_number": 25,
        "field_name": "Defrost_Control",
        "field_id": "A8",
        "type": "choice",
        "required": false,
        "description": "How defrost cycles are initiated.",
        "default": "OnDemand",
        "choices": [
          {
            "value": "Timed",
            "description": "Defrost at fixed intervals"
          },
          {
            "value": "OnDemand",
            "description": "Defrost when coil frost detected. More efficient.",
            "recommended": true
          }
        ],
        "example": "OnDemand"
      },
      {
        "field_number": 26,
        "field_name": "Defrost_Time_Period_Fraction",
        "field_id": "N18",
        "type": "real",
        "required": false,
        "description": "Fraction of time spent in defrost during timed control.",
        "default": 0.058333,
        "typical_range": "0.03-0.1",
        "example": 0.058333,
        "notes": "Default = 3.5 minutes per hour"
      },
      {
        "field_number": 27,
        "field_name": "Resistive_Defrost_Heater_Capacity",
        "field_id": "N19",
        "type": "real",
        "units": "W",
        "required": "conditional",
        "description": "Capacity of resistive defrost heaters. REQUIRED if Defrost_Strategy = Resistive.",
        "default": "Autosize",
        "example": "Autosize",
        "critical_dependency": "Must be > 0 or 'Autosize' when Defrost_Strategy = Resistive",
        "common_error": "Warning if Resistive strategy but capacity = 0"
      },
      {
        "field_number": 28,
        "field_name": "Maximum_Outdoor_Dry_Bulb_Temperature_for_Defrost_Operation",
        "field_id": "N20",
        "type": "real",
        "units": "C",
        "required": false,
        "description": "Defrost only occurs below this temperature.",
        "default": 5.0,
        "typical_range": "2-7",
        "example": 5.0
      },
      {
        "field_number": 29,
        "field_name": "Condenser_Type",
        "field_id": "A9",
        "type": "choice",
        "required": false,
        "description": "Type of condenser heat rejection.",
        "default": "AirCooled",
        "choices": [
          {
            "value": "AirCooled",
            "description": "Standard air-cooled condenser. Most common.",
            "recommended": true
          },
          {
            "value": "EvaporativelyCooled",
            "description": "Evaporative cooling for hot/dry climates"
          },
          {
            "value": "WaterCooled",
            "description": "Water-cooled, requires condenser water loop"
          }
        ],
        "example": "AirCooled"
      },
      {
        "field_number": 30,
        "field_name": "Water_Condenser_Volume_Flow_Rate",
        "field_id": "N21",
        "type": "real",
        "units": "m3/s",
        "required": "conditional",
        "description": "Water flow rate for water-cooled condenser.",
        "default": null,
        "notes": "Only used when Condenser_Type = WaterCooled"
      },
      {
        "field_number": 31,
        "field_name": "Evaporative_Condenser_Effectiveness",
        "field_id": "N22",
        "type": "real",
        "required": false,
        "description": "Effectiveness of evaporative cooling.",
        "default": 0.9,
        "typical_range": "0.7-0.95",
        "notes": "Only used when Condenser_Type = EvaporativelyCooled"
      },
      {
        "field_number": 32,
        "field_name": "Evaporative_Condenser_Air_Flow_Rate",
        "field_id": "N23",
        "type": "real",
        "units": "m3/s",
        "required": false,
        "description": "Air flow rate through evaporative condenser.",
        "default": "Autosize",
        "notes": "Only used when Condenser_Type = EvaporativelyCooled"
      },
      {
        "field_number": 33,
        "field_name": "Evaporative_Condenser_Pump_Rated_Power_Consumption",
        "field_id": "N24",
        "type": "real",
        "units": "W",
        "required": false,
        "description": "Power consumption of evaporative condenser pump.",
        "default": "Autosize",
        "notes": "Only used when Condenser_Type = EvaporativelyCooled"
      },
      {
        "field_number": 34,
        "field_name": "Basin_Heater_Capacity",
        "field_id": "N25",
        "type": "real",
        "units": "W/K",
        "required": false,
        "description": "Capacity of basin heater to prevent freezing.",
        "default": 0.0,
        "notes": "Only used with EvaporativelyCooled or WaterCooled"
      },
      {
        "field_number": 35,
        "field_name": "Basin_Heater_Setpoint_Temperature",
        "field_id": "N26",
        "type": "real",
        "units": "C",
        "required": false,
        "description": "Temperature below which basin heater operates.",
        "default": 2.0,
        "example": 2.0
      },
      {
        "field_number": 36,
        "field_name": "Basin_Heater_Operating_Schedule_Name",
        "field_id": "A10",
        "type": "alpha",
        "required": false,
        "description": "Schedule for basin heater operation.",
        "default": null
      },
      {
        "field_number": 37,
        "field_name": "Fuel_Type",
        "field_id": "A11",
        "type": "choice",
        "required": false,
        "description": "Energy source for the VRF system.",
        "default": "Electricity",
        "choices": ["Electricity", "NaturalGas", "Propane", "FuelOilNo1", "FuelOilNo2", "Diesel", "Gasoline", "Coal", "OtherFuel1", "OtherFuel2"],
        "example": "Electricity",
        "notes": "Most VRF systems are electric. Gas-fired heat pumps use NaturalGas."
      }
    ],

    "common_configurations": [
      {
        "name": "Standard Air-Cooled VRF",
        "description": "Basic configuration for most applications",
        "key_settings": {
          "Condenser_Type": "AirCooled",
          "Defrost_Strategy": "ReverseCycle",
          "Heat_Pump_Waste_Heat_Recovery": "No",
          "Master_Thermostat_Priority_Control_Type": "LoadPriority"
        }
      },
      {
        "name": "Heat Recovery VRF",
        "description": "Simultaneous heating and cooling for mixed-use buildings",
        "key_settings": {
          "Heat_Pump_Waste_Heat_Recovery": "Yes",
          "Master_Thermostat_Priority_Control_Type": "LoadPriority"
        },
        "benefits": "Up to 30% energy savings in buildings with simultaneous loads"
      },
      {
        "name": "Cold Climate VRF",
        "description": "Optimized for heating-dominated climates",
        "key_settings": {
          "Minimum_Outdoor_Temperature_in_Heating_Mode": -25,
          "Rated_Heating_Capacity_Sizing_Ratio": 1.2,
          "Defrost_Strategy": "ReverseCycle",
          "Defrost_Control": "OnDemand"
        }
      }
    ]
  },

  "hvactemplate_zone_vrf": {
    "object_name": "HVACTemplate:Zone:VRF",
    "description": "Creates a VRF terminal unit for a single zone. Each zone served by the VRF system requires one of these objects.",
    "total_fields": 42,
    "required_fields": ["Zone_Name", "Template_VRF_System_Name", "Template_Thermostat_Name"],
    
    "field_groups": {
      "identification": {
        "fields": [1, 2, 3],
        "description": "Zone name, system reference, and thermostat reference"
      },
      "sizing": {
        "fields": [4, 5, 6],
        "description": "Zone sizing factors"
      },
      "airflow": {
        "fields": [7, 8, 9, 10],
        "description": "Supply air flow rates for different modes"
      },
      "outdoor_air": {
        "fields": [11, 12, 13, 14, 15, 16, 17, 18, 19],
        "description": "Outdoor air ventilation settings"
      },
      "scheduling": {
        "fields": [20, 21],
        "description": "Availability and fan operation schedules"
      },
      "fan": {
        "fields": [22, 23, 24, 25],
        "description": "Supply fan configuration"
      },
      "cooling_coil": {
        "fields": [26, 27, 28, 29],
        "description": "Cooling coil settings"
      },
      "heating_coil": {
        "fields": [30, 31, 32],
        "description": "Heat pump heating coil settings"
      },
      "supplemental_heating": {
        "fields": [33, 34, 35, 36],
        "description": "Backup heating for cold climates"
      },
      "parasitic_loads": {
        "fields": [37, 38],
        "description": "Terminal unit standby power"
      },
      "advanced": {
        "fields": [39, 40, 41, 42],
        "description": "Advanced features including baseboard heating"
      }
    },

    "detailed_fields": [
      {
        "field_number": 1,
        "field_name": "Zone_Name",
        "field_id": "A1",
        "type": "alpha",
        "required": true,
        "description": "Name of the zone served by this terminal unit. Must match a Zone object.",
        "example": "Office_Zone_1"
      },
      {
        "field_number": 2,
        "field_name": "Template_VRF_System_Name",
        "field_id": "A2",
        "type": "alpha",
        "required": true,
        "description": "Name of the HVACTemplate:System:VRF that this terminal connects to.",
        "example": "VRF_System_1"
      },
      {
        "field_number": 3,
        "field_name": "Template_Thermostat_Name",
        "field_id": "A3",
        "type": "alpha",
        "required": true,
        "description": "Name of the HVACTemplate:Thermostat that controls this zone.",
        "example": "Thermostat_Office_Zone_1",
        "critical": "This field MUST reference a valid HVACTemplate:Thermostat object. Missing thermostat causes simulation failure."
      },
      {
        "field_number": 4,
        "field_name": "Zone_Heating_Sizing_Factor",
        "field_id": "N1",
        "type": "real",
        "required": false,
        "description": "Multiplier for zone heating load calculation.",
        "default": "blank (uses Sizing:Parameters)",
        "typical_range": "1.0-1.5"
      },
      {
        "field_number": 5,
        "field_name": "Zone_Cooling_Sizing_Factor",
        "field_id": "N2",
        "type": "real",
        "required": false,
        "description": "Multiplier for zone cooling load calculation.",
        "default": "blank (uses Sizing:Parameters)"
      },
      {
        "field_number": 6,
        "field_name": "Rated_Total_Heating_Capacity_Sizing_Ratio",
        "field_id": "N3",
        "type": "real",
        "required": false,
        "description": "Ratio of heating to cooling capacity for this terminal.",
        "default": 1.0
      },
      {
        "field_number": 7,
        "field_name": "Cooling_Supply_Air_Flow_Rate",
        "field_id": "N4",
        "type": "real",
        "units": "m3/s",
        "required": false,
        "description": "Air flow rate during cooling operation.",
        "default": "Autosize",
        "example": "Autosize"
      },
      {
        "field_number": 8,
        "field_name": "No_Cooling_Supply_Air_Flow_Rate",
        "field_id": "N5",
        "type": "real",
        "units": "m3/s",
        "required": false,
