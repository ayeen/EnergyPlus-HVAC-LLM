! ===============================================================
! INTENTIONALLY BROKEN HVAC OBJECTS - FOR AGENT 3 TESTING
! ===============================================================
! ERRORS IN THIS FILE:
! 1. MasterThermostatPriority requires zone name but field 13 is empty
! 2. Invalid condenser type "InvalidCondenserType" (should be AirCooled/WaterCooled)
! 3. HVACTemplate:Zone:VRF references non-existent schedule "Missing_Schedule"
! ===============================================================

HVACTemplate:System:VRF,
    Broken_VRF_System,        !- Name
    Always On,                !- System Availability Schedule Name
    Autosize,                 !- Gross Rated Total Cooling Capacity {W}
    3.5,                      !- Gross Rated Cooling COP
    -10,                      !- Minimum Outdoor Temperature in Cooling Mode {C}
    48,                       !- Maximum Outdoor Temperature in Cooling Mode {C}
    Autosize,                 !- Gross Rated Heating Capacity {W}
    1.0,                      !- Rated Heating Capacity Sizing Ratio
    3.5,                      !- Gross Rated Heating COP
    -25,                      !- Minimum Outdoor Temperature in Heating Mode {C}
    18,                       !- Maximum Outdoor Temperature in Heating Mode {C}
    0.25,                     !- Minimum Heat Pump Part-Load Ratio
    ,                         !- Zone Name for Master Thermostat Location (ERROR: empty but required)
    MasterThermostatPriority, !- Master Thermostat Priority Control Type
    ,                         !- Thermostat Priority Schedule Name
    ,                         !- Zone Terminal Unit List Name
    No,                       !- Heat Pump Waste Heat Recovery
    50,                       !- Equivalent Piping Length used for Piping Correction Factor in Cooling Mode {m}
