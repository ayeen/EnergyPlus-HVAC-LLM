! ===============================================================
! SCHEDULE TYPE LIMITS
! ===============================================================
ScheduleTypeLimits,
    Fraction,                 !- Name
    0,                        !- Lower Limit Value
    1,                        !- Upper Limit Value
    Continuous;               !- Numeric Type

ScheduleTypeLimits,
    Any Number;               !- Name

! ===============================================================
! SCHEDULES
! ===============================================================
Schedule:Compact,
    AlwaysOn,                 !- Name
    Fraction,                 !- Schedule Type Limits Name
