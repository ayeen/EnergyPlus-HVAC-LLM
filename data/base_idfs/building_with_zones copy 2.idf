VERSION,
    25.1;                     !- Version Identifier

SimulationControl,
  Yes,                       !- Do Zone Sizing Calculation
  Yes,                       !- Do System Sizing Calculation
  No,                        !- Do Plant Sizing Calculation
  Yes,                       !- Run Simulation for Sizing Periods
  Yes;                       !- Run Simulation for Weather File Run Periods

Building,
  My_First_Building,         !- Name
  0.0,                       !- North Axis {deg}
  Suburbs;                   !- Terrain

Site:Location,
  CHICAGO_IL_USA_TMY3,       !- Name
  41.78,                     !- Latitude {deg}
  -87.75,                    !- Longitude {deg}
  -6.0,                      !- Time Zone {hr}
  190.0;                     !- Elevation {m}

Timestep,
  4;                         !- Number of Timesteps per Hour

RunPeriod,
  Full_Run,                  !- Name
  1,                         !- Begin Month
  1,                         !- Begin Day of Month
  12,                        !- End Month
  31,                        !- End Day of Month
  Sunday,                    !- Day of Week for Start Day
  Yes,                       !- Use Weather File Holidays and Special Days
  Yes,                       !- Use Weather File Daylight Saving Period
  No,                        !- Apply Weekend Holiday Rule
  Yes,                       !- Use Weather File Rain Indicators
  Yes;                       !- Use Weather File Snow Indicators

  Schedule:TypeLimits,
  On-Off,                    !- Name
  0,                         !- Lower Limit Value
  1,                         !- Upper Limit Value
  DISCRETE;                  !- Numeric Type

  GLOBALGEOMETRYRULES,
    UpperLeftCorner,          !- Starting Vertex Position
    Counterclockwise,         !- Vertex Entry Direction
    Relative,                 !- Coordinate System
    Relative,                 !- Daylighting Reference Point Coordinate System
    Relative;                 !- Rectangular Surface Coordinate System

!=============================================================================
!                    SCHEDULE
!=============================================================================

Schedule:TypeLimits,
  Temperature,               !- Name
  -60,                       !- Lower Limit Value
  200,                       !- Upper Limit Value
  CONTINUOUS;                !- Numeric Type

Schedule:Compact,
  Office_Hours,              !- Name
  On-Off,                    !- Schedule Type Limits Name
  Through: 12/31,            !- Field 1
  For: Weekdays,             !- Field 2
  Until: 08:00, 0.0,         !- Field 3
  Until: 18:00, 1.0,         !- Field 4
  Until: 24:00, 0.0,         !- Field 5
  For: AllOtherDays,         !- Field 6
  Until: 24:00, 0.0;         !- Field 7

Schedule:Compact,
  Heating_Setpoint_Schedule, !- Name
  Temperature,               !- Schedule Type Limits Name
  Through: 12/31,            !- Field 1
  For: Weekdays,             !- Field 2
  Until: 07:00, 18.0,        !- Field 3
  Until: 18:00, 21.0,        !- Field 4
  Until: 24:00, 18.0,        !- Field 5
  For: AllOtherDays,         !- Field 6
  Until: 24:00, 18.0;        !- Field 7

Schedule:Compact,
  Cooling_Setpoint_Schedule, !- Name
  Temperature,               !- Schedule Type Limits Name
  Through: 12/31,            !- Field 1
  For: Weekdays,             !- Field 2
  Until: 07:00, 26.0,        !- Field 3
  Until: 18:00, 24.0,        !- Field 4
  Until: 24:00, 26.0,        !- Field 5
  For: AllOtherDays,         !- Field 6
  Until: 24:00, 26.0;        !- Field 7

