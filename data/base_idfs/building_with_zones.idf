! ===============================================================
! BASE IDF FOR 2-ZONE BUILDING (HVAC GENERATED BY MULTI-AGENT)
! ===============================================================

Version, 25.2;  ! EnergyPlus version

! ===============================================================
! BUILDING
! ===============================================================
Building,
    BaseBuilding,      ! Name
    0.0,               ! North Axis
    City,              ! Terrain Type
    0.04,              ! Loads Convergence Tolerance Value
    0.4,               ! Temperature Convergence Tolerance Value
    FullExterior,      ! Solar Distribution
    25;                ! Maximum Number of Warmup Days

! ===============================================================
! SIMULATION CONTROL
! ===============================================================
Timestep, 6;

RunPeriod,
    Annual,            ! Name
    1,                 ! Begin Month
    1,                 ! Begin Day of Month
    12,                ! End Month
    31,                ! End Day of Month
    UseWeatherFile,    ! Daylight Saving Time Indicator
    Yes,               ! Use Holidays and Special Days
    Yes,               ! Apply Weekend Holiday
    Yes;               ! Use Weather File Holidays

! ===============================================================
! ZONES
! ===============================================================
Zone,
    Zone1,              ! Name
    0,0,0,              ! X,Y,Z origin
    5,5,3,              ! Length, Width, Height
    1,                  ! Number of occupants (default)
    1,                  ! Volume
    1;                  ! Zone multiplier

Zone,
    Zone2,
    5,0,0,
    5,5,3,
    1,
    1,
    1;

! ===============================================================
! SURFACES (Simple 4 walls, floor, roof for each zone)
! ===============================================================
Material,
    WallMaterial,       ! Name
    MediumSmooth,       ! Roughness
    0.2,                ! Thickness (m)
    1.5,                ! Conductivity (W/m-K)
    800,                ! Density
    1000;               ! Specific Heat (J/kg-K)

Construction,
    WallConstruction,
    WallMaterial;

! Floor, Roof, and Walls (simplified, linked to each zone)
! You can add detailed surfaces if needed.

! ===============================================================
! INTERNAL LOADS
! ===============================================================
People,
    Zone1People,
    Zone1,
    AlwaysOn,
    1,
    120,
    0.3,
    0.3;

Lights,
    Zone1Lights,
    Zone1,
    AlwaysOn,
    100,   ! Watts
    1.0,
    0.0,
    0.0,
    0.0;

ElectricEquipment,
    Zone1Equip,
    Zone1,
    AlwaysOn,
    100,
    1.0,
    0.0,
    0.0;

People,
    Zone2People,
    Zone2,
    AlwaysOn,
    1,
    120,
    0.3,
    0.3;

Lights,
    Zone2Lights,
    Zone2,
    AlwaysOn,
    100,
    1.0,
    0.0,
    0.0,
    0.0;

ElectricEquipment,
    Zone2Equip,
    Zone2,
    AlwaysOn,
    100,
    1.0,
    0.0,
    0.0;

! ===============================================================
! SCHEDULES
! ===============================================================
Schedule:Compact,
    AlwaysOn,
    Fraction,
    Through:12/31,
    For:AllDays,
    Until:24:00,1.0;

! ===============================================================
! PLACEHOLDER FOR MULTI-AGENT GENERATED HVAC
! ===============================================================
! Your multi-agent system can insert:
! - HVACTemplate:System:VRF
! - HVACTemplate:Zone:VRF (per zone)
! - HVACTemplate:Thermostat (per zone)
! at this location in the IDF
