    1.887;                    !- ASHRAE Clear Sky Optical Depth for Diffuse Irradiance taud

RunPeriod,
    RUNPERIOD 1,              !- Name
    1,                        !- Begin Month
    1,                        !- Begin Day of Month
    ,                         !- Begin Year
    12,                       !- End Month
    31,                       !- End Day of Month
    ,                         !- End Year
    Sunday,                   !- Day of Week for Start Day
