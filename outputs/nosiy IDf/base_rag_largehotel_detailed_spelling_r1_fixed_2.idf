    1,                        !- Duration
    Holiday;                  !- Special Day Type

RunPeriodControl:SpecialDays,
    Presidents Day,           !- Name
    3rd Monday in February,    !- Start Date
    1,                        !- Duration
    Holiday;                  !- Special Day Type

RunPeriodControl:SpecialDays,
    Memorial Day,             !- Name
