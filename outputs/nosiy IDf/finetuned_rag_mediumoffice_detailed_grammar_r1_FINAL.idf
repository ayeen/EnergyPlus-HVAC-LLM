	PV_module,               !- Name
	5,                       !- PVWatts Version
	32176.5,  !- DC System Capacity {W}
	Premium,                 !- Module Type
	FixedOpenRack,           !- Array Type
	0.113,                   !- System Losses
	TiltAzimuth,             !- Array Geometry Type
	0,                       !- Tilt Angle {deg}
	180,                     !- Azimuth Angle {deg}
	,                        !- Surface Name
	;                        !- Ground Coverage Ratio

!-   ===========  ALL OBJECTS IN CLASS: ELECTRICLOADCENTER:GENERATORS ===========

ElectricLoadCenter:Generators,
	PV_Generator,            !- Name
	PV_module,               !- Generator 1 Name
	Generator:PVWatts,       !- Generator 1 Object Type
	32176.5,  !- Generator 1 Rated Electric Power Output {W}
	PV_SCH,                  !- Generator 1 Availability Schedule Name
	;                        !- Generator 1 Rated Thermal to Electrical Power Ratio

Schedule:Compact,
	PV_SCH,                  !- Name
	Fraction,                !- Schedule Type Limits Name
	Through: 12/31,          !- Field 1
	For: AllDays,            !- Field 2
	Until: 24:00,1;          !- Field 3

!-   ===========  ALL OBJECTS IN CLASS: ELECTRICLOADCENTER:INVERTER:PVWatts ===========

ElectricLoadCenter:Inverter:PVWatts,
	PV_Inverter,             !- Name
	1.2,                     !- DC to AC Size Ratio
	0.96;                    !- Inverter Efficiency

!-   ===========  ALL OBJECTS IN CLASS: ELECTRICLOADCENTER:DISTRIBUTION ===========

