MATERIAL,
    DefaultWallMaterial,      !- Name
    MediumRough,              !- Roughness
    0.2,                      !- Thickness
    0.9,                      !- Conductivity
    1800,                     !- Density
    900,                      !- Specific Heat
    0.9,                      !- Thermal Absorptance
