!-~~~~ SWHLoops_tmpl ~~~

!-   ===========  All objects for service water heating system loops ===========
  Sizing:Plant,
    SWHSysShower,                 !- Plant or Condenser Loop Name
    Heating,                 !- Loop Type
    60,                      !- Design Loop Exit Temperature {C}
    5.0;                     !- Loop Design Temperature Difference {deltaC}

  PlantLoop,
    SWHSysShower,                 !- Name
    WATER,                   !- Fluid Type
    ,                        !- User Defined Fluid Type
    SWHSysShower Loop Operation Scheme List,  !- Plant Equipment Operation Scheme Name
    SWHSysShower Supply Outlet Node,  !- Loop Temperature Setpoint Node Name
    60,                      !- Maximum Loop Temperature {C}
    10.0,                    !- Minimum Loop Temperature {C}
    AUTOSIZE,                !- Maximum Loop Flow Rate {m3/s}
    0.0,                     !- Minimum Loop Flow Rate {m3/s}
    AUTOSIZE,                !- Plant Loop Volume {m3}
    SWHSysShower Supply Inlet Node,  !- Plant Side Inlet Node Name
    SWHSysShower Supply Outlet Node,  !- Plant Side Outlet Node Name
    SWHSysShower Supply Branches, !- Plant Side Branch List Name
    SWHSysShower Supply Connectors,  !- Plant Side Connector List Name
    SWHSysShower Demand Inlet Node,  !- Demand Side Inlet Node Name
    SWHSysShower Demand Outlet Node,  !- Demand Side Outlet Node Name
    SWHSysShower Demand Branches, !- Demand Side Branch List Name
    SWHSysShower Demand Connectors,  !- Demand Side Connector List Name
    Optimal;                 !- Load Distribution Scheme

  Pump:ConstantSpeed,
    SWHSysShower Pump,            !- Name
    SWHSysShower Supply Inlet Node,  !- Inlet Node Name
    SWHSysShower Pump-Water HeaterNodeviaConnector,  !- Outlet Node Name
    autosize,                !- Design Flow Rate {m3/s}
    29891,                   !- Design Pump Head {Pa}
    AUTOSIZE,                !- Design Power Consumption {W}
    0.85,                    !- Motor Efficiency
    0.0,                     !- Fraction of Motor Inefficiencies to Fluid Stream
    Intermittent;            !- Pump Control Type

  BranchList,
    SWHSysShower Supply Branches, !- Name
    SWHSysShower Supply Inlet Branch,  !- Branch 1 Name
    SWHSysShower Supply Equipment Branch,  !- Branch 2 Name
    SWHSysShower Supply Equipment Bypass Branch,  !- Branch 3 Name
    SWHSysShower Supply Outlet Branch;  !- Branch 4 Name

  Branch,
    SWHSysShower Supply Inlet Branch,  !- Name
    ,                        !- Pressure Drop Curve Name
    Pump:ConstantSpeed,      !- Component 1 Object Type
    SWHSysShower Pump,            !- Component 1 Name
    SWHSysShower Supply Inlet Node,  !- Component 1 Inlet Node Name
    SWHSysShower Pump-Water HeaterNodeviaConnector;  !- Component 1 Outlet Node Name

