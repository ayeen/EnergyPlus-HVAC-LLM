    HotelSmall,              !- Name
    180,          !- North Axis {deg}
    Suburbs,                 !- Terrain
    0.0400,                  !- Loads Convergence Tolerance Value {W}
    0.4,                     !- Temperature Convergence Tolerance Value {deltaC}
