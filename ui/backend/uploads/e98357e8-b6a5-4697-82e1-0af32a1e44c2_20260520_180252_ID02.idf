  S1_Z1_Ceiling,           !- Name
  Ceiling,                 !- Surface Type
  Interior_Floor,          !- Construction Name
  Story1_Zone1,            !- Zone Name
  Surface,                 !- Outside Boundary Condition
  S2_Z1_Floor,             !- Outside Boundary Condition Object (Maps to Story 2)
  NoSun,                   !- Sun Exposure
  NoWind,                  !- Wind Exposure
  0.0,                     !- View Factor to Ground
  4,                       !- Number of Vertices
  0.0, 0.0, 3.5,           !- X,Y,Z Vertex 1 {m}
  10.0, 0.0, 3.5,          !- X,Y,Z Vertex 2 {m}
  10.0, 15.0, 3.5,         !- X,Y,Z Vertex 3 {m}
  0.0, 15.0, 3.5;          !- X,Y,Z Vertex 4 {m}

