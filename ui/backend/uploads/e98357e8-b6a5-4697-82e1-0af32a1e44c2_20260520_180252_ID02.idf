!-Generator EnergyPlus V23.1.0 Baseline for VRF-HVAC Workflow
!-Case ID: 02 | Class: Low-Rise | Stories: 2 | Zones: 2 | Area: 150m2 per floor | WWR: ~30%
!-Facade Split: Two Split Windows Per Facade with Architectural Gap (Applied to S1 & S2)

Version, 25.2;

SimulationControl,
  Yes,                     !- Do Zone Sizing Calculation
  No,                      !- Do System Sizing Calculation
  No,                      !- Do Plant Sizing Calculation
  Yes,                     !- Run Simulation for Sizing Periods
  No;                      !- Run Simulation for Weather File Run Periods

Building,
  Case_02_LowRise_2Zone_10x15, !- Name
  0.0,                     !- North Axis {deg}
  Suburbs,                 !- Terrain
  0.04,                    !- Loads Convergence Tolerance Value
  0.4,                     !- Temperature Convergence Tolerance Value {deltaC}
  FullExterior,            !- Solar Distribution
  25,                      !- Maximum Number of Warmup Days
  6;                       !- Minimum Number of Warmup Days

Timestep, 4;

GlobalGeometryRules,
  UpperLeftCorner,         !- Starting Vertex Position
  CounterClockWise,        !- Vertex Entry Direction
  Relative;                !- Coordinate System

!- --- SCHEDULES ---
ScheduleTypeLimits,
  Fraction,                !- Name
  0.0, 1.0, Continuous;    !- Range

Schedule:Constant,
  AlwaysOn,                !- Name
  Fraction,                !- Schedule Type Limits Name
  1.0;                     !- Value

!- --- MATERIALS & CONSTRUCTIONS ---
Material,
  Wall_Insulation,         !- Name
  Rough,                   !- Roughness
  0.1,                     !- Thickness {m}
  0.03,                    !- Conductivity {W/m-K}
  43.0,                    !- Density {kg/m3}
  1210,                    !- Specific Heat {J/kg-K}
  0.9,                     !- Thermal Absorptance
  0.7,                     !- Solar Absorptance
  0.7;                     !- Visible Absorptance

Construction,
  Exterior_Wall,           !- Name
  Wall_Insulation;         !- Layer 1

Material,
  Roof_Insulation,         !- Name
  Rough,                   !- Roughness
  0.15,                    !- Thickness {m}
  0.03,                    !- Conductivity {W/m-K}
  43.0,                    !- Density {kg/m3}
  1210,                    !- Specific Heat {J/kg-K}
  0.9,                     !- Thermal Absorptance
  0.7,                     !- Solar Absorptance
  0.7;                     !- Visible Absorptance

Construction,
  Exterior_Roof,           !- Name
  Roof_Insulation;         !- Layer 1

Material,
  Floor_Concrete,          !- Name
  Rough,                   !- Roughness
  0.2,                     !- Thickness {m}
  1.6,                     !- Conductivity {W/m-K}
  2400,                    !- Density {kg/m3}
  880,                     !- Specific Heat {J/kg-K}
  0.9,                     !- Thermal Absorptance
  0.7,                     !- Solar Absorptance
  0.7;                     !- Visible Absorptance

Construction,
  Ground_Floor,            !- Name
  Floor_Concrete;          !- Layer 1

Construction,
  Interior_Floor,          !- Name
  Floor_Concrete;          !- Layer 1

WindowMaterial:SimpleGlazingSystem,
  Clear_Glass,             !- Name
  2.4,                     !- U-Factor {W/m2-K}
  0.45,                    !- Solar Heat Gain Coefficient (SHGC)
  0.7;                     !- Visible Transmittance

Construction,
  External_Window,         !- Name
  Clear_Glass;             !- Layer 1


!- =========================================================================
!- --- GEOMETRY: STORY 1 (0.0m to 3.5m) ---
!- =========================================================================
Zone,
  Story1_Zone1,            !- Name
  0.0, 0.0, 0.0, 0.0,      !- Direction, X, Y, Z Origins
  1, 1,                    !- Type, Multiplier
  3.5;                     !- Ceiling Height {m}

BuildingSurface:Detailed,
  S1_Z1_Floor,             !- Name
  Floor,                   !- Surface Type
  Ground_Floor,            !- Construction Name
  Story1_Zone1,            !- Zone Name
  Ground,                  !- Outside Boundary Condition
  ,                        !- Outside Boundary Condition Object
  NoSun,                   !- Sun Exposure
  NoWind,                  !- Wind Exposure
  0.0,                     !- View Factor to Ground
  4,                       !- Number of Vertices
  10.0, 0.0, 0.0,          !- X,Y,Z Vertex 1 {m}
  0.0, 0.0, 0.0,           !- X,Y,Z Vertex 2 {m}
  0.0, 15.0, 0.0,          !- X,Y,Z Vertex 3 {m}
  10.0, 15.0, 0.0;         !- X,Y,Z Vertex 4 {m}

